{
  "name": "qalqan-platform",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@qalqan/web",
    "build": "npm run build --workspace=@qalqan/web",
    "lint": "npm run lint --workspace=@qalqan/web",
    "start": "npm run start --workspace=@qalqan/web",
    "db:push": "npm run prisma --workspace=@qalqan/api -- db push",
    "db:seed": "npm run seed --workspace=@qalqan/api"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "lucide-react": "^1.47.0"
  }
}
