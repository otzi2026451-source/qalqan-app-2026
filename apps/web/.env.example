# Server-side Gemini configuration (do NOT expose the secret key in the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Public AI endpoint used by the static GitHub Pages frontend
# Example: https://your-backend.example.com/api/chat
NEXT_PUBLIC_CHAT_API_URL=https://your-backend.example.com/api/chat
